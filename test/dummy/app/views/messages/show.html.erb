<%= turbo_stream_from current_contact, :messages %>
<div class="flex h-full">
  <%= render "message_panel" %>

  <%# Message detail %>
  <div class="flex-1 overflow-y-auto scrollbar-thin bg-gray-50">
    <%= turbo_frame_tag "message_detail", class: "block h-full" do %>
      <div class="h-full flex flex-col">
        <div class="flex-1 overflow-y-auto">
          <%= render MessageSummaryComponent.new(summary: MessageSummary.new(message: @message)) %>
          <%= render MessageDetailComponent.new(message: @message) %>
        </div>
        <div class="border-t border-gray-200 bg-white px-6 py-4"
             data-controller="presence"
             data-presence-stream-value="<%= ReactiveComponent.signed_stream(current_contact, :messages) %>">
          <div id="viewers" class="flex gap-2 mb-2"></div>
          <button type="button" id="share_cursor" class="text-xs text-gray-500 mb-2"
                  data-action="presence#shareCursor">Share cursor</button>
          <label class="block text-xs uppercase tracking-wide text-gray-400 mb-1">Reply</label>
          <textarea rows="3" id="reply_body"
                    class="w-full rounded border border-gray-200 p-2 text-sm"
                    data-presence-field="reply_body"
                    data-action="focus->presence#claim blur->presence#release"></textarea>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%# Host-app rendering of the roster. The gem stamps attributes and dispatches
    this event; what the roster looks like is the app's decision. %>
<script>
  document.addEventListener("reactive-presence:changed", (event) => {
    const list = document.getElementById("viewers")
    if (!list) return

    list.replaceChildren(...event.detail.others.map((entry) => {
      const chip = document.createElement("button")
      chip.type = "button"
      chip.className = "viewer text-xs px-2 py-1 rounded bg-gray-100"
      chip.textContent = entry.user.name
      chip.dataset.viewerId = entry.user.id
      chip.dataset.sharing = String(entry.state.sharing === true)
      chip.dataset.watching = entry.state.watching == null ? "" : String(entry.state.watching)
      chip.dataset.action = "presence#watch"
      chip.dataset.presenceUserIdParam = entry.user.id
      return chip
    }))
  })
</script>

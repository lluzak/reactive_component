<!DOCTYPE html>
<html class="h-full bg-gray-100">
  <head>
    <title>ReactiveComponent Demo</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      /* The gem stamps attributes and appends the cursor layer; everything it
         looks like is the app's decision, so it lives here. */
      .reactive-presence-layer { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 30; }

      .reactive-presence-cursor {
        position: absolute; top: 0; left: 0;
        width: 14px; height: 14px;
        border-radius: 50% 50% 50% 2px;
        background: var(--presence-color, #64748b);
        box-shadow: 0 1px 3px rgba(0,0,0,.35);
        transition: transform 85ms linear;
        will-change: transform;
      }

      .reactive-presence-cursor::after {
        content: attr(data-presence-user);
        position: absolute; top: 16px; left: 10px;
        padding: 1px 6px; border-radius: 3px 8px 8px 8px;
        background: var(--presence-color, #64748b);
        color: #fff; font-size: 10px; line-height: 1.5; white-space: nowrap;
      }

      /* Initials only. The name is in the title, and a lineup of circles reads
         faster than a row of labels once more than two people are here. */
      .viewer {
        position: relative;
        width: 26px; height: 26px; padding: 0; border: 0;
        border-radius: 50%; display: grid; place-items: center;
        background: var(--avatar-color, #64748b);
        color: #fff; font-size: 9.5px; font-weight: 700; letter-spacing: .02em;
        cursor: default;
      }

      /* A green dot means that person is broadcasting a cursor you can follow. */
      .viewer[data-sharing="true"] { cursor: pointer; }
      .viewer[data-sharing="true"]::after {
        content: ""; position: absolute; right: -1px; bottom: -1px;
        width: 8px; height: 8px; border-radius: 50%;
        background: #22c55e; box-shadow: 0 0 0 2px #111827;
      }

      /* You are following them: a full white ring. */
      .viewer[data-following="true"] { box-shadow: 0 0 0 2px #fff; }

      /* They are following you: an eye on the opposite corner from the dot. */
      .viewer[data-watching-me="true"]::before {
        content: "\25C9";
        position: absolute; right: -3px; top: -3px;
        width: 11px; height: 11px; border-radius: 50%;
        background: #111827; color: #fff;
        font-size: 8px; line-height: 11px; text-align: center;
      }

      /* Somebody else is about to drop a card in this column. */
      [data-incoming] { position: relative; outline: 2px dashed #f59e0b; outline-offset: 2px; }

      [data-incoming]::after {
        content: attr(data-incoming) " is dropping here";
        position: absolute; left: 8px; top: -9px;
        padding: 0 5px; border-radius: 3px;
        background: #f59e0b; color: #422006;
        font-size: 9px; font-weight: 600; line-height: 1.6; white-space: nowrap;
      }

      /* Where a card would land if released now. Blue for your own drag, amber
         with a name for somebody else's, in the same spot drop() would use. */
      .drop-slot { height: 4px; margin: 2px 4px; border-radius: 2px; background: #3b82f6; position: relative; }
      .drop-slot--theirs { background: #f59e0b; }
      .drop-slot--theirs::after {
        content: attr(data-by); position: absolute; right: 0; top: -13px;
        padding: 0 4px; border-radius: 3px; background: #f59e0b; color: #422006;
        font-size: 9px; font-weight: 600; line-height: 1.5; white-space: nowrap;
      }

      /* The travelling copy. Deliberately the same card at full opacity with a
         lift, because the point is to look like the thing being dragged. */
      .drag-preview {
        position: absolute; top: 0; left: 0;
        pointer-events: none;
        rotate: -3deg;
        /* Frames arrive at 20 Hz; the same short transition the cursor uses
           turns them into motion instead of a series of jumps. */
        transition: transform 85ms linear;
        will-change: transform;
        box-shadow: 0 12px 28px -8px rgba(0,0,0,.55);
        outline: 2px solid #f59e0b;
        background: #fff;
      }

      /* A demo that keeps being reported as broken should be able to say what
         it thinks is happening. Everything here comes from the events the gem
         already dispatches, plus the controller's own state. */
      #presence-debug {
        position: fixed; left: 8px; bottom: 8px; z-index: 100;
        background: #111827; color: #e5e7eb; border-radius: 6px;
        padding: 7px 9px; font: 11px/1.6 ui-monospace, SFMono-Regular, Menlo, monospace;
        box-shadow: 0 6px 20px -6px rgba(0,0,0,.5); max-width: 320px;
      }
      #presence-debug b { color: #fff; font-weight: 600; }
      #presence-debug .bad { color: #f87171; }
      #presence-debug .good { color: #4ade80; }
      #presence-debug button {
        float: right; margin-left: 8px; border: 0; background: transparent;
        color: #9ca3af; cursor: pointer; font: inherit;
      }

      /* Shown until somebody else is on the stream. The gem stamps
         data-presence-here on the controller element the moment one is. */
      [data-presence-here] [data-alone] { display: none; }
      [data-alone] { color: #6b7280; font-size: 11px; }

      .legend { display: inline-flex; gap: 10px; color: #6b7280; font-size: 10px; }
      .legend b { color: #374151; font-weight: 600; }
      .following-pill { background: #111827; }

      /* Following somebody should be obvious, not a 2px ring you have to hunt. */
      .following-pill {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 2px 4px 2px 2px; border-radius: 999px;
        background: rgba(255,255,255,.12); color: #fff; font-size: 11px;
      }

      .following-pill .avatar {
        width: 18px; height: 18px; border-radius: 50%;
        display: grid; place-items: center;
        background: var(--avatar-color, #64748b);
        font-size: 8px; font-weight: 700;
      }

      .following-pill button {
        border: 0; border-radius: 999px; padding: 1px 7px;
        background: rgba(255,255,255,.18); color: #fff;
        font-size: 10px; cursor: pointer;
      }

      .following-pill button:hover { background: rgba(255,255,255,.3); }

      /* A card somebody else has picked up. It reads as lifted out of the
         column, the same way it looks to the person dragging it: the slot stays
         open as a dashed gap and the card itself travels with their cursor. */
      .card-shell[data-presence-busy] { position: relative; cursor: not-allowed; }

      .card-shell[data-presence-busy] > div {
        outline: 2px dashed #f59e0b;
        outline-offset: 1px;
        opacity: .35;
        background: repeating-linear-gradient(45deg, #fffbeb 0 6px, #fef3c7 6px 12px);
      }

      /* While their card is in flight, the gap holds its place rather than the
         column collapsing and everything below jumping. */
      .card-shell[data-presence-busy][data-lifted="true"] > div > * { visibility: hidden; }

      .card-shell[data-presence-busy]::after {
        content: attr(data-presence-busy) " is moving this";
        position: absolute; left: 0; top: -9px;
        padding: 0 5px; border-radius: 3px;
        background: #f59e0b; color: #422006;
        font-size: 9px; font-weight: 600; line-height: 1.6; white-space: nowrap;
      }
    </style>
    <%# The viewer rides the socket URL so each tab connects as itself. %>
    <meta name="action-cable-url" content="<%= "/cable?as=#{viewer_id}" %>">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {}
        }
      }
    </script>
    <style type="text/tailwindcss">
      @layer utilities {
        .scrollbar-thin {
          scrollbar-width: thin;
          scrollbar-color: theme('colors.gray.300') transparent;
        }
        .scrollbar-thin:hover {
          scrollbar-color: theme('colors.gray.400') transparent;
        }
        .scrollbar-thin::-webkit-scrollbar {
          width: 6px;
          height: 6px;
        }
        .scrollbar-thin::-webkit-scrollbar-track {
          background: transparent;
        }
        .scrollbar-thin::-webkit-scrollbar-thumb {
          background-color: theme('colors.gray.300');
          border-radius: 3px;
        }
        .scrollbar-thin::-webkit-scrollbar-thumb:hover {
          background-color: theme('colors.gray.400');
        }
      }
    </style>
    <%= javascript_importmap_tags %>
  </head>
  <body class="h-full">
    <%# No login here: pick who you are. It is a query parameter rather than a
        cookie so a second tab can be a second person. %>
    <div class="flex items-center gap-3 bg-gray-900 px-4 py-1.5 text-xs text-gray-400">
      <span class="uppercase tracking-wide">Viewing as</span>
      <% Contact.order(:id).each do |contact| %>
        <%# A full page load, not a Turbo visit: the cable consumer is built once
            from the meta tag below, so swapping identity has to rebuild it. %>
        <a href="<%= "#{request.path}?as=#{contact.id}" %>" data-turbo="false"
           class="<%= viewer_id.to_s == contact.id.to_s ? "text-white font-semibold" : "hover:text-gray-200" %>"
           data-viewer-pick="<%= contact.id %>"><%= contact.name %></a>
      <% end %>
      <span class="text-gray-500">open a second window and pick a different name to see presence</span>
    </div>

    <%= yield %>
  <%# Host-app rendering of the roster. The gem stamps attributes and dispatches
    this event; what the roster looks like is the app's decision. %>
<script>
  document.addEventListener("reactive-presence:changed", (event) => {
    const list = document.getElementById("viewers")
    if (!list) return

    const presence = event.target
    const controller = window.Stimulus
      ? window.Stimulus.getControllerForElementAndIdentifier(presence, "presence")
      : null
    const following = controller?.watching ?? null
    const selfId = controller?.roster?.selfId ?? null

    list.replaceChildren(...event.detail.others.map((entry) => {
      const sharing = entry.state.sharing === true
      const isFollowed = following === entry.user.id

      const chip = document.createElement(sharing ? "button" : "span")
      chip.className = "viewer"
      chip.dataset.viewerId = entry.user.id
      chip.dataset.sharing = String(sharing)
      chip.dataset.following = String(isFollowed)
      chip.dataset.watching = entry.state.watching == null ? "" : String(entry.state.watching)
      chip.style.setProperty("--avatar-color", entry.user.color || "#64748b")
      chip.textContent = entry.user.initials || entry.user.name.slice(0, 2).toUpperCase()

      const watchingMe = entry.state.watching === selfId
      chip.dataset.watchingMe = String(watchingMe)

      chip.title = [
        entry.user.name,
        sharing ? (isFollowed ? "you are following their cursor" : "sharing — click to follow") : "not sharing a cursor",
        watchingMe ? "following your cursor" : null
      ].filter(Boolean).join(" · ")

      if (sharing && !isFollowed) {
        chip.type = "button"
        chip.dataset.action = "presence#watch"
        chip.dataset.presenceUserIdParam = entry.user.id
      }

      return chip
    }))

    const followingEntry = event.detail.others.find((entry) => entry.user.id === following)
    const followingSlot = document.getElementById("following_status")

    if (followingSlot) {
      followingSlot.replaceChildren()
      if (followingEntry) {
        const pill = document.createElement("span")
        pill.className = "following-pill"
        pill.style.setProperty("--avatar-color", followingEntry.user.color || "#64748b")

        const avatar = document.createElement("span")
        avatar.className = "avatar"
        avatar.textContent = followingEntry.user.initials || followingEntry.user.name.slice(0, 2).toUpperCase()

        const label = document.createElement("span")
        label.textContent = `following ${followingEntry.user.name}`

        const stop = document.createElement("button")
        stop.type = "button"
        stop.textContent = "stop"
        stop.dataset.action = "presence#watch"
        stop.dataset.presenceUserIdParam = followingEntry.user.id

        pill.append(avatar, label, stop)
        followingSlot.append(pill)
      }
    }

    // Everything else is on the avatars themselves, so the only prose left is
    // the one relationship you can act on.
    const legend = document.getElementById("cursor_hint")
    if (legend) legend.hidden = event.detail.others.length === 0
  })

  // Nothing leaves this browser until somebody follows you, so say so rather
  // than letting the button look inert.
  document.addEventListener("click", (event) => {
    const button = event.target.closest("#share_cursor")
    if (!button) return

    button.textContent = "Sharing your cursor"
    button.classList.add("bg-white", "font-medium", "text-gray-900")
    button.disabled = true
  })
</script>
  
<div id="presence-debug" hidden></div>
<script>
  // Diagnostics for the demo, not part of the gem.
  (() => {
    const box = document.getElementById("presence-debug")
    if (!box) return

    let cursorFrames = 0
    let lastRoster = null

    document.addEventListener("reactive-presence:changed", () => { lastRoster = Date.now() })
    document.addEventListener("reactive-presence:cursor", (event) => { if (event.detail.at) cursorFrames++ })

    const controller = () => {
      const el = document.querySelector('[data-controller~="presence"]')
      return el && window.Stimulus ? window.Stimulus.getControllerForElementAndIdentifier(el, "presence") : null
    }

    const row = (label, value, state) =>
      `<div><b>${label}</b> <span class="${state || ''}">${value}</span></div>`

    const render = () => {
      const cable = document.querySelector('meta[name="action-cable-url"]')?.content || "none"
      const named = /as=\d+/.test(cable)
      const c = controller()
      const connected = !!document.querySelector("[data-reactive-renderer-connected]")

      if (!c) {
        box.innerHTML = '<button title="hide">x</button>' +
          row("presence", "not on this page", "bad") + row("socket", cable, named ? "" : "bad")
        return
      }

      const others = c.roster.others()
      const watchers = others.filter(o => o.state.watching === c.roster.selfId).map(o => o.user.name)
      box.innerHTML =
        '<button title="hide">x</button>' +
        row("you", c.roster.selfId == null ? "not identified yet" : `#${c.roster.selfId}`, c.roster.selfId == null ? "bad" : "good") +
        row("socket", cable, named ? "" : "bad") +
        row("cable", connected ? "connected" : "not connected", connected ? "good" : "bad") +
        row("here", others.length ? others.map(o => o.user.name).join(", ") : "nobody else", others.length ? "good" : "bad") +
        row("sharing", c.sharing ? "yes" : "no") +
        row("following", c.watching == null ? "nobody" : `#${c.watching}`) +
        row("watching you", watchers.length ? watchers.join(", ") : "nobody") +
        row("sampling mouse", c.sampler ? "yes" : "no") +
        row("cursor frames", cursorFrames) +
        row("last roster event", lastRoster ? `${Math.round((Date.now() - lastRoster) / 1000)}s ago` : "never", lastRoster ? "" : "bad")
    }

    box.addEventListener("click", (event) => { if (event.target.tagName === "BUTTON") box.hidden = true })
    box.hidden = false
    render()
    setInterval(render, 1000)
  })()
</script>
  </body>
</html>
